<Window
    x:Class="BirdyCreditStatus.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon">

    <Grid>
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ToolTipText="Birdy Credit Status"
            IconSource="Assets/TrayIcon.ico"
            NoLeftClickDelay="True"
            PopupActivation="DoubleClick"
            LeftClickCommand="{x:Bind TogglePopupCommand}">
            <tb:TaskbarIcon.ContextFlyout>
                <!-- #23: H.NotifyIcon zeigt das Menü als NATIVES Win32-Menü und reicht
                     Klicks nur an Command weiter (Click/Opening feuern nie). Darum
                     Command-Bindings statt Click-Handler. -->
                <MenuFlyout>
                    <MenuFlyoutItem Text="App aktualisieren …" Command="{x:Bind UpdateAppCommand}" />
                    <ToggleMenuFlyoutItem x:Name="AutostartItem" Text="Mit Windows starten" Command="{x:Bind ToggleAutostartCommand}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Beenden" Command="{x:Bind ExitCommand}" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
